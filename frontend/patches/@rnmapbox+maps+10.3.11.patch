+  /// Replaces the style's 3D lights (one ambient + one directional) without reloading the style.
+  @objc public func setLightsWithLightsJSON(
+    _ lightsJSON: String,
+    resolver: @escaping RCTPromiseResolveBlock,
+    rejecter: @escaping RCTPromiseRejectBlock
+  ) {
+    do {
+      guard let data = lightsJSON.data(using: .utf8),
+            let lights = try JSONSerialization.jsonObject(with: data) as? [[String: Any]] else {
+        rejecter("setLights", "lights must be a JSON array", nil)
+        return
+      }
+      var ambient: AmbientLight?
+      var directional: DirectionalLight?
+      for light in lights {
+        let lightData = try JSONSerialization.data(withJSONObject: light)
+        switch light["type"] as? String {
+        case "ambient": ambient = try JSONDecoder().decode(AmbientLight.self, from: lightData)
+        case "directional": directional = try JSONDecoder().decode(DirectionalLight.self, from: lightData)
+        default: break
+        }
+      }
+      guard let ambient = ambient, let directional = directional else {
+        rejecter("setLights", "need one ambient and one directional light", nil)
+        return
+      }
+      try self.mapboxMap.setLights(ambient: ambient, directional: directional)
+      resolver(nil)
+    } catch {
+      rejecter("setLights", error.localizedDescription, error)
+    }
+  }
